# NON-SECRET configuration only. Copy to a server operator-controlled location outside Git.
# Never put actual API keys or bearer values here. No .env file is loaded automatically by relay.py.
RELAY_HOSTNAME=relay.example.invalid
ACME_EMAIL=operator@example.invalid
# Required absolute Unix epoch expiry. Replace before deployment; do not renew it on restart.
APP_ACCESS_TOKEN_EXPIRES_AT=
OPENAI_MODEL=gpt-4.1-mini
RELAY_REQUESTS_PER_MINUTE=6
RELAY_REQUESTS_PER_DAY=100
RELAY_MAX_CONCURRENT=2
# Absolute paths to files delivered by the server Secret manager; values are not credentials.
OPENAI_API_KEY_SECRET_FILE=/etc/jarvis/secrets/openai_api_key
APP_ACCESS_TOKEN_SECRET_FILE=/etc/jarvis/secrets/app_access_token
