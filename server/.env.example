# Variable names only; actual values must come from the SERVER Secret manager.
# The production Compose profile injects the two FILE paths automatically.
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
APP_ACCESS_TOKEN_FILE=/run/secrets/app_access_token
# Required absolute Unix expiry in production; empty is deliberately not deployable.
APP_ACCESS_TOKEN_EXPIRES_AT=
RELAY_REQUIRE_EXPLICIT_EXPIRY=true
OPENAI_MODEL=gpt-4.1-mini
RELAY_REQUESTS_PER_MINUTE=6
RELAY_REQUESTS_PER_DAY=100
RELAY_MAX_CONCURRENT=2
# Managed-host Secret env injection (outside Compose) may supply OPENAI_API_KEY
# and APP_ACCESS_TOKEN instead. Never set both VALUE and VALUE_FILE.
# relay.py does not automatically load .env files.
